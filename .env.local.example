NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional error monitoring (Sentry). Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Performance tracing is off by default; set 0.05 to sample 5% of requests.
SENTRY_TRACES_SAMPLE_RATE=0

# Optional Playwright critical-path test. Requires a local Supabase instance.
E2E_BASE_URL=http://localhost:3000
